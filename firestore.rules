rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // データモデル概要（social-insurance-app 実装準拠）
    // ===============================================================
    // accounts/{uid}           - ログインユーザーのアカウント
    // accounts/{uid}/notifications/{id} - 個人・事業所向け通知
    // affiliations/{uid}_{tid} - ユーザーと事業所の所属関係（role: admin|member）
    // tenants/{tid}            - 事業所マスタ
    // tenants/{tid}/employees/{eid} - 従業員
    // tenants/{tid}/applications/{id} - 休業・退職等の申請
    // tenants/{tid}/invitations/{id} - 招待（作成は Cloud Functions）
    // tenants/{tid}/settings/{settingId} - 各種設定
    // tenants/{tid}/insuranceRates/{rateId} - 保険料率
    // tenants/{tid}/monthly-records/{yyyyMm}/employees/{eid} - 月次給与
    // tenants/{tid}/bonus-records/{yyyyMm}/employees/{eid} - 賞与
    // tenants/{tid}/employees/{eid}/standardRemuneration|standardBonus/{yyyyMm}
    // invitation-mails/{id} - 開発用仮想メール（本番では無効化を推奨）
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function affiliationId(uid, tid) {
      return uid + '_' + tid;
    }

    function affiliationRef(uid, tid) {
      return /databases/$(database)/documents/affiliations/$(affiliationId(uid, tid));
    }

    function affiliationSnap(uid, tid) {
      return get(affiliationRef(uid, tid));
    }

    function hasAffiliation(uid, tid) {
      return affiliationSnap(uid, tid).exists;
    }

    function affiliationData(uid, tid) {
      return affiliationSnap(uid, tid).data;
    }

    function isTenantMember(tid) {
      return signedIn()
        && hasAffiliation(request.auth.uid, tid)
        && affiliationData(request.auth.uid, tid).tid == tid
        && affiliationData(request.auth.uid, tid).uid == request.auth.uid;
    }

    function isTenantAdmin(tid) {
      return isTenantMember(tid)
        && affiliationData(request.auth.uid, tid).role == 'admin';
    }

    function isActiveTenantMember(tid) {
      return isTenantMember(tid)
        && affiliationData(request.auth.uid, tid).status == 'active';
    }

    function accountSnap() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function ownEmployeeId(tid) {
      return accountSnap().data.get('affiliations', {}).get(tid, '');
    }

    function isOwnEmployee(tid, eid) {
      return signedIn() && ownEmployeeId(tid) == eid;
    }

    function isEmployeeSelf() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function memberAffiliationUpdateValid() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'updatedAt']);
    }

    function affiliationCoreFieldsImmutable() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.tid == resource.data.tid;
    }

    function memberReadableSetting(settingId) {
      return settingId == 'monthlyListSetting'
        || settingId == 'monthlySetting'
        || settingId == 'bonusListSetting'
        || settingId == 'bonusSetting'
        || settingId == 'allowanceKindSetting';
    }

    function isLockedMonthlyPeriod(tid, yyyyMm) {
      return get(/databases/$(database)/documents/tenants/$(tid)/monthly-records/$(yyyyMm))
        .data.get('locked', false) == true;
    }

    function isLockedBonusPeriod(tid, yyyyMm) {
      return get(/databases/$(database)/documents/tenants/$(tid)/bonus-records/$(yyyyMm))
        .data.get('locked', false) == true;
    }

    function hasDeliveredSourceMonth(tid, eid, yyyyMm) {
      return exists(/databases/$(database)/documents/tenants/$(tid)/employees/$(eid)/deliveredSourceMonths/$(yyyyMm));
    }

    function hasDeliveredBonusMonth(tid, eid, yyyyMm) {
      return exists(/databases/$(database)/documents/tenants/$(tid)/employees/$(eid)/deliveredBonusMonths/$(yyyyMm));
    }

    function accountSelfUpdateValid() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['personalInfo', 'currentTenantId', 'lastView', 'updatedAt'])
        && (
          !keys.hasAny(['currentTenantId'])
          || isTenantMember(request.resource.data.currentTenantId)
        );
    }

    function memberEmployeeUpdateValid() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return (
        keys.hasOnly(['employeePersonalInfo', 'updatedAt'])
        || keys.hasOnly(['employeePersonalInfo', 'multiWorkplaceSettings', 'updatedAt'])
        || keys.hasOnly([
          'employeePersonalInfo.realName',
          'employeePersonalInfo.myNumber',
          'employeePersonalInfo.basicPensionNumber',
          'employeePersonalInfo.birthDate',
          'updatedAt',
        ])
      )
        && request.resource.data.get('uid', resource.data.uid) == resource.data.uid
        && request.resource.data.get('role', resource.data.role) == resource.data.role;
    }

    function applicationCreateValid(tid) {
      return request.resource.data.eid == ownEmployeeId(tid)
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['allowance', 'leave', 'resign', 'personal_info', 'dependents']
        && request.resource.data.keys().hasAll([
          'eid', 'employeeId', 'displayName', 'type', 'status',
          'createdAt', 'updatedAt',
        ]);
    }

    function auditLogCreateValid() {
      return request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete']
        && request.resource.data.keys().hasAll([
          'actorUid', 'actorDisplayName', 'targetKind', 'action',
          'category', 'summary', 'createdAt',
        ]);
    }

    function notificationSelfUpdateValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ===============================================================
    // accounts
    // ===============================================================

    match /accounts/{uid} {
      allow read: if isSelf(uid);
      allow create: if false;
      allow update: if isSelf(uid) && accountSelfUpdateValid();
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create: if false;
        allow update: if isSelf(uid) && notificationSelfUpdateValid();
        allow delete: if isSelf(uid);
      }
    }

    // ===============================================================
    // affiliations
    // ===============================================================

    match /affiliations/{affiliationDocId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && memberAffiliationUpdateValid()
        || isTenantAdmin(resource.data.tid)
        && affiliationCoreFieldsImmutable();
      allow delete: if false;
    }

    // ===============================================================
    // tenants
    // ===============================================================

    match /tenants/{tid} {
      allow read: if isTenantMember(tid);
      allow create: if false;
      allow update: if isTenantAdmin(tid);
      allow delete: if false;

      match /employees/{eid} {
        allow read: if isTenantAdmin(tid) || isEmployeeSelf();
        allow create: if false;
        allow update: if isTenantAdmin(tid)
          || (isEmployeeSelf() && memberEmployeeUpdateValid());
        allow delete: if false;

        match /standardRemuneration/{yyyyMm} {
          allow read, write: if isTenantAdmin(tid);
        }

        match /standardBonus/{yyyyMm} {
          allow read, write: if isTenantAdmin(tid);
        }

        match /paymentStatementDeliveries/{displayYyyyMm} {
          allow read: if isTenantAdmin(tid)
            || (isActiveTenantMember(tid) && isOwnEmployee(tid, eid));
          allow write: if false;
        }

        match /deliveredSourceMonths/{yyyyMm} {
          allow read: if isTenantAdmin(tid)
            || (isActiveTenantMember(tid) && isOwnEmployee(tid, eid));
          allow write: if false;
        }

        match /deliveredBonusMonths/{yyyyMm} {
          allow read: if isTenantAdmin(tid)
            || (isActiveTenantMember(tid) && isOwnEmployee(tid, eid));
          allow write: if false;
        }
      }

      match /paymentStatementDeliveryStatus/{displayYyyyMm} {
        allow read: if isTenantAdmin(tid);
        allow write: if false;
      }

      match /applications/{applicationId} {
        allow read: if isTenantAdmin(tid)
          || (isActiveTenantMember(tid) && isOwnEmployee(tid, resource.data.eid));
        allow create: if isActiveTenantMember(tid) && applicationCreateValid(tid);
        allow update: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
      }

      match /invitations/{invitationId} {
        allow read, delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /settings/{settingId} {
        allow read: if isTenantAdmin(tid)
          || (isActiveTenantMember(tid) && memberReadableSetting(settingId));
        allow write: if isTenantAdmin(tid);
      }

      match /insuranceRates/{rateId} {
        allow read, write: if isTenantAdmin(tid);
      }

      match /monthly-records/{yyyyMm} {
        allow read: if isTenantAdmin(tid);
        allow write: if isTenantAdmin(tid);

        match /employees/{eid} {
          allow read: if isTenantAdmin(tid)
            || (isActiveTenantMember(tid)
              && isOwnEmployee(tid, eid)
              && hasDeliveredSourceMonth(tid, eid, yyyyMm));
          allow write: if isTenantAdmin(tid);
        }
      }

      match /bonus-records/{yyyyMm} {
        allow read: if isTenantAdmin(tid);
        allow write: if isTenantAdmin(tid);

        match /employees/{eid} {
          allow read: if isTenantAdmin(tid)
            || (isActiveTenantMember(tid)
              && isOwnEmployee(tid, eid)
              && hasDeliveredBonusMonth(tid, eid, yyyyMm));
          allow write: if isTenantAdmin(tid);
        }
      }

      match /premiumCalculationJobs/{jobId} {
        allow read, write: if false;

        match /items/{eid} {
          allow read, write: if false;
        }
      }

      match /notifications/{notificationId} {
        allow read, write: if false;
      }

      match /mayJuneZuijiReviews/{reviewId} {
        allow read: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /teijiNonTargetAlerts/{alertId} {
        allow read: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /standardZuijiAlerts/{alertId} {
        allow read: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /multiWorkplacePremiumAlerts/{alertId} {
        allow read: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /leavePremiumExemptionAlerts/{alertId} {
        allow read: if isTenantAdmin(tid);
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /remunerationConsentReviews/{reviewId} {
        allow read: if isTenantAdmin(tid)
          || (isActiveTenantMember(tid) && resource.data.eid == ownEmployeeId(tid));
        allow delete: if isTenantAdmin(tid);
        allow create, update: if false;
      }

      match /registrationFilings/{filingId} {
        allow read, create: if isTenantAdmin(tid);
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isTenantAdmin(tid);
        allow create: if isActiveTenantMember(tid) && auditLogCreateValid();
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // 開発用仮想メール（virtual-mail-checker）
    // ===============================================================

    match /invitation-mails/{mailId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
